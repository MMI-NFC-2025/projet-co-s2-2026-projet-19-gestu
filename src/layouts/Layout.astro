---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Gestu' } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Press+Start+2P&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <!-- Fond neutre visible sur les grands écrans, contenu centré façon "mobile frame" -->
  <body class="bg-gestu-bg md:flex md:justify-center">
    <div class="relative w-full md:max-w-md md:min-h-screen">
      <slot />
    </div>
  </body>
</html>
