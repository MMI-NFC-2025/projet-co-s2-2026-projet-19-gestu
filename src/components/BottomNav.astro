---
import apprendre from '../assets/icon/icone_apprendre.svg';
import jeux from '../assets/icon/icone_manette.svg';
import boutique from '../assets/icon/icone_boutique.svg';
import teams from '../assets/icon/icone_teams.svg';

interface Props {
  active?: 'accueil' | 'apprendre' | 'jeux' | 'boutique' | 'teams';
}

const { active } = Astro.props;

const navItems = [
  { label: 'Apprendre', icon: apprendre, href: '/apprendre', key: 'apprendre' },
  { label: 'Jeux', icon: jeux, href: '/jeux', key: 'jeux' },
  { label: 'Boutique', icon: boutique, href: '/boutique', key: 'boutique' },
  { label: 'Teams', icon: teams, href: '/teams', key: 'teams' },
];
---

<!-- Navigation principale de l'application -->
<nav aria-label="Navigation principale" class="flex w-full items-center justify-around bg-gestu-bg px-2 pb-6 pt-3">
  {navItems.map((item) => (
    <a
      href={item.href}
      aria-current={active === item.key ? 'page' : undefined}
      class={`flex flex-col items-center transition-opacity active:scale-95 ${active === item.key ? 'opacity-100' : 'opacity-60'}`}
    >
      <img src={item.icon.src} alt={item.label} class="h-12 w-12 object-contain" />
    </a>
  ))}
</nav>
