---
const { page = 'home' } = Astro.props;

const homeLinks = [
  { label: 'Concept', href: '#concept' },
  { label: 'Mini-jeux', href: '#jeux' },
  { label: 'Fonctionnalités', href: '#fonctionnalites' },
  { label: 'Contact', href: '#contact' },
  { label: 'Publics & impact', href: '/public-impact' },
];

const detailLinks = [
  { label: 'Accueil', href: '/' },
  { label: 'Concept', href: '/#concept' },
  { label: 'Fonctionnalités', href: '/#fonctionnalites' },
  { label: 'Contact', href: '/#contact' },
  { label: 'Publics', href: '#publics' },
  { label: 'Impact', href: '#impact' },
];

const links = page === 'details' ? detailLinks : homeLinks;
---

<header class="sticky top-0 z-50 border-b border-cyan-300/20 bg-[#08005f]/85 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 lg:px-8" aria-label="Navigation principale">
    <a href={page === 'details' ? '/' : '#top'} class="font-pixel text-sm text-white sm:text-base">GESTU</a>

    <div class="hidden items-center gap-8 font-title text-sm font-bold text-indigo-100 lg:flex">
      {links.map((link) => (
        <a class="transition hover:text-cyan-200" href={link.href}>{link.label}</a>
      ))}
    </div>

    <a href={page === 'details' ? '/' : '#contact'} class="neon-button rounded-2xl bg-white px-5 py-3 font-pixel text-[10px] text-[#1500e8] transition hover:-translate-y-0.5 hover:bg-cyan-100 sm:text-xs">
      {page === 'details' ? 'Retour' : 'Contact'}
    </a>
  </nav>
</header>
