---
/**
 * En-tête commun à toutes les pages de l'application.
 * Affiche les coins du joueur, sa barre d'XP et un bouton de retour.
 *
 * Les valeurs dynamiques (coins, xp, xpMax, xpPercent) sont liées
 * à Alpine.js depuis le composant parent via x-data.
 */
import coinsIcon from '../assets/icon/coins.svg';
import retourIcon from '../assets/icon/icone_retour_acceuil.svg';

interface Props {
  /** URL de la page de retour */
  retourHref: string;
  /** Texte accessible du bouton retour */
  retourLabel: string;
  /** Thème visuel : 'dark' (fond sombre, défaut) ou 'light' (fond clair) */
  theme?: 'dark' | 'light';
  /** Classes CSS supplémentaires sur l'élément header */
  extraClass?: string;
}

const { retourHref, retourLabel, theme = 'dark', extraClass = '' } = Astro.props;
---

<!-- TODO: coins, xp et xpMax sont récupérés depuis PocketBase (collection Utilisateurs) via Alpine -->
<header class:list={['flex items-center justify-between px-4 pt-4', extraClass]}>

  <!-- Coins (gauche) -->
  <div class="flex items-center gap-2">
    <img src={coinsIcon.src} alt="Coins" class="h-9 w-9" />
    <span
      class:list={['text-xl font-bold', theme === 'light' ? 'text-[#0D0D3B]' : 'text-white']}
      x-text="coins"
    >—</span>
  </div>

  <!-- Barre XP + bouton retour (droite) -->
  <div class="flex items-center gap-2">
    <div
      class:list={[
        'h-4 w-36 overflow-hidden rounded-full',
        theme === 'light' ? 'bg-[#0D0D3B]/20' : 'bg-white/20',
      ]}
      role="progressbar"
      aria-label="Points d'expérience"
      :aria-valuenow="xp"
      :aria-valuemax="xpMax"
      aria-valuemin="0"
    >
      <div
        class:list={[
          'h-full rounded-full transition-all',
          theme === 'light' ? 'bg-[#1F1F8F]' : 'bg-purple-400',
        ]}
        :style="`width: ${xpPercent}%`"
      ></div>
    </div>

    <a
      href={retourHref}
      aria-label={retourLabel}
      class:list={[
        theme === 'light' && 'flex h-10 w-10 items-center justify-center rounded-full bg-[#1F1F8F] shadow-md',
      ]}
    >
      <img
        src={retourIcon.src}
        alt=""
        class:list={[theme === 'light' ? 'h-7 w-7' : 'h-9 w-9']}
      />
    </a>
  </div>

</header>
