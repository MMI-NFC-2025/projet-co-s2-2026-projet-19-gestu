---
/**
 * En-tête commun à toutes les pages de l'application.
 * Affiche les coins du joueur, sa barre d'XP et un bouton de retour.
 *
 * Les valeurs dynamiques (coins, xp, xpMax, xpPercent) sont liées
 * à Alpine.js depuis le composant parent via x-data.
 */
import coinsIcon from '../assets/icon/coins.svg';
import retourIcon from '../assets/icon/icone_retour_acceuil.svg';

interface Props {
  retourHref: string;
  retourLabel: string;
  theme?: 'dark' | 'light';
  extraClass?: string;
  showLevel?: boolean;
}

const { retourHref, retourLabel, theme = 'dark', extraClass = '', showLevel = false } = Astro.props;
---

<!-- TODO: coins, xp et xpMax sont récupérés depuis PocketBase (collection Utilisateurs) via Alpine -->
<header class:list={['flex items-center justify-between px-4 pt-4 w-full', extraClass]}>

  <!-- Coins (gauche) -->
  <div class="flex items-center gap-2 mr-4">
    <img src={coinsIcon.src} alt="Coins" class="h-9 w-9" />
    <span
      class:list={['text-xl font-bold', theme === 'light' ? 'text-[#0D0D3B]' : 'text-white']}
      x-text="coins"
    >—</span>
  </div>

  <!-- Barre XP + niveau + bouton retour (droite) -->
  <div class="flex items-center gap-2">
    <div
      class:list={[
        'h-4 w-28 overflow-hidden rounded-full',
        theme === 'light' ? 'bg-gestu-bg/20' : 'bg-white/20',
      ]}
      role="progressbar"
      aria-label="Points d'expérience"
      :aria-valuenow="xp"
      :aria-valuemax="xpMax"
      aria-valuemin="0"
    >
      <div
        class:list={[
          'h-full rounded-full transition-all duration-1000',
          theme === 'light' ? 'bg-[#1F1F8F]' : 'bg-purple-400',
        ]}
        :style="`width: ${xpPercent}%`"
      ></div>
    </div>

    {showLevel && (
      <span
        x-text="`${niveaux}`"
        style="font-family:'Press Start 2P',monospace;font-size:7px;white-space:nowrap;"
        class:list={[theme === 'light' ? 'text-[#0D0D3B]' : 'text-white']}
      ></span>
    )}

    <a
      href={retourHref}
      aria-label={retourLabel}
      class:list={[
        theme === 'light' && 'flex h-10 w-10 items-center justify-center rounded-full bg-[#1F1F8F] shadow-md',
      ]}
    >
      <img
        src={retourIcon.src}
        alt=""
        class:list={[theme === 'light' ? 'h-7 w-7' : 'h-9 w-9']}
      />
    </a>
  </div>

</header>
