---
import Layout from '../layouts/Layout.astro';
import BottomNav from '../components/BottomNav.astro';
import PageHeader from '../components/PageHeader.astro';
import cercle from '../assets/icon/cercle_appli.svg';
import ghost from '../assets/icon/ghost_acceuil.svg';
---

<Layout title="Gestu — Dashboard">
  <div
    class="relative flex h-screen w-full flex-col overflow-hidden"
    style="background: linear-gradient(180deg, #0D0D3B 0%, #1a0a4a 100%);"
    x-data="dashboardData()"
    x-init="init()"
    data-ghost-default={ghost.src}
  >

    <PageHeader retourHref="/dashboard" retourLabel="Tableau de bord" showLevel={true} />

    <!-- Zone centrale : cercles + ghost -->
    <main class="relative flex flex-1 items-center justify-center">

      <!-- Néon rayonnant derrière les cercles -->
      <div
        class="absolute rounded-full pointer-events-none"
        style="width:55vw;height:55vw;max-width:220px;max-height:220px;background:radial-gradient(circle,rgba(160,80,255,0.55) 0%,rgba(100,20,220,0.25) 50%,transparent 75%);filter:blur(18px);"
      ></div>

      <!-- Cercles concentriques violets avec effet néon -->
      <img
        src={cercle.src}
        alt=""
        class="absolute h-[130vw] w-[130vw] max-h-162.5 max-w-162.5 object-contain"
        style="filter: drop-shadow(0 0 18px rgba(160,80,255,0.85)) drop-shadow(0 0 40px rgba(120,40,220,0.5));"
      />

      <!-- Ghost centré cliquable -->
      <a href="/personnalisation" aria-label="Personnaliser mon personnage" class="relative z-10 flex items-center justify-center transition-transform active:scale-95" style="width:42vw;height:42vw;max-width:168px;max-height:168px;">
        <img
          :src="avatarUrl || ghostDefault"
          alt="Mon personnage"
          class="w-full h-full object-contain"
          style="filter: drop-shadow(0 0 12px rgba(200,150,255,0.7));"
        />
      </a>
    </main>
    <BottomNav active="accueil" />

  </div>
</Layout>

<script>
  import pb from '../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('dashboardData', () => ({
      coins: 0,
      xp: 0,
      xpMax: 100,
      xpPercent: 0,
      niveaux: 1,
      avatarUrl: '',
      ghostDefault: '',

      async init() {
        this.ghostDefault = document.querySelector('[data-ghost-default]')?.getAttribute('data-ghost-default') || '';

        if (!pb.authStore.isValid) {
          window.location.href = '/login';
          return;
        }

        const userId = String(pb.authStore.model?.id ?? '');
        if (!userId) {
          window.location.href = '/login';
          return;
        }

        const user = await pb.collection('Utilisateurs').getOne(userId, {
          requestKey: null,
        });

        this.coins = user?.coins ?? 0;
        this.xp = user?.xp ?? 0;
        this.niveaux = user?.niveaux ?? 1;
        this.xpMax = this.niveaux * 50 + 50;

        // 1. Lire depuis localStorage (persistance fiable après sélection d'avatar)
        try {
          const cached = JSON.parse(localStorage.getItem('gestu_avatar_' + userId) || 'null');
          if (cached?.imageUrl) {
            this.avatarUrl = cached.imageUrl;
          }
        } catch {}

        // 2. Sinon tenter PocketBase (user.avatar = ID Objets_boutique si la relation le permet)
        if (!this.avatarUrl) {
          const avatarId = user?.avatar;
          if (avatarId) {
            try {
              const skin = await pb.collection('Objets_boutique').getOne(avatarId, { requestKey: null });
              const f = skin?.image || skin?.image_avatar;
              this.avatarUrl = f ? pb.files.getURL(skin, f) : '';
            } catch {}
          }
        }

        // Démarrer à 0 puis animer vers la vraie valeur
        this.xpPercent = 0;
        setTimeout(() => {
          this.xpPercent = Math.min(Math.round((this.xp / this.xpMax) * 100), 100);
        }, 300);
      }
    }));
  });
</script>
