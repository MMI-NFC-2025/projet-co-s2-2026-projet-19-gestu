---
import Layout from '../layouts/Layout.astro';
import BottomNav from '../components/BottomNav.astro';
import coinsIcon from '../assets/icon/coins.svg';
import retour from '../assets/icon/icone_retour_acceuil.svg';
import gameboyFond from '../assets/img/gameboy_fond_apprendre.avif';
---

<Layout title="Gestu — Apprendre">
  <div
    class="relative flex h-screen w-full flex-col overflow-hidden"
    style="background: linear-gradient(180deg, #0D0D3B 0%, #1a0a4a 100%);"
    x-data="apprendreData()"
    x-init="init()"
  >

    <!-- Image de fond gameboy -->
    <img
      src={gameboyFond.src}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-top opacity-60 pointer-events-none select-none"
    />

    <!-- Header -->
    <div class="relative z-10 flex items-center justify-between px-4 pt-4">
      <div class="flex items-center gap-2">
        <img src={coinsIcon.src} alt="Coins" class="h-9 w-9" />
        <span class="text-xl font-bold text-white" x-text="coins">—</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="h-4 w-36 overflow-hidden rounded-full bg-white/20">
          <div
            class="h-full rounded-full bg-purple-400 transition-all"
            :style="`width: ${xpPercent}%`"
          ></div>
        </div>
        <a href="/dashboard">
          <img src={retour.src} alt="Accueil" class="h-9 w-9" />
        </a>
      </div>
    </div>

    <!-- Liste de catégories scrollable -->
    <div class="relative z-10 flex-1 overflow-y-auto px-4 pt-4 pb-20" x-show="!loading">
      <div class="flex flex-col gap-3">
        <template x-for="cat in categories" :key="cat.id">
          <a :href="`/apprendre/${cat.id}`" class="block">
            <!-- Image directe sans fond -->
            <div style="height: 110px;">
              <img
                x-show="cat.imageUrl"
                :src="cat.imageUrl"
                :alt="cat.nom"
                class="h-full object-contain object-left"
                @error="console.warn('Image introuvable:', cat.nom, cat.imageUrl); cat.imageUrl = ''"
              />
            </div>
          </a>
        </template>

        <!-- Fallback : vide -->
        <div x-show="!loading && categories.length === 0" class="flex flex-col items-center gap-2 py-10 text-white/40">
          <span>Aucune catégorie trouvée</span>
        </div>
      </div>
    </div>

    <!-- Bottom Navigation -->
    <BottomNav active="apprendre" />
  </div>
</Layout>

<script>
  import pb from '../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('apprendreData', () => ({
      coins: 0,
      xp: 0,
      xpMax: 100,
      xpPercent: 0,
      categories: [] as any[],
      loading: true,

      async init() {
        const DEV_MODE = true;
        const user = DEV_MODE ? { coins: 150, xp: 420 } : pb.authStore.model;
        this.coins = user?.coins ?? 0;
        this.xp = user?.xp ?? 0;
        this.xpPercent = Math.min(Math.round((this.xp / this.xpMax) * 100), 100);

        try {
          const records = await pb.collection('Categories_signe').getFullList({
            sort: 'ordre_affichage',
          });
          this.categories = records.map((r: any) => ({
            id: r.id,
            nom: r.nom_categorie,
            imageUrl: r.image ? pb.files.getURL(r, r.image) + `?t=${r.updated}` : '',
          }));
        } catch {
          // Fallback DEV
          this.categories = [
            { id: 'besoin',       nom: 'besoin',       imageUrl: '' },
            { id: 'sport',        nom: 'sport',        imageUrl: '' },
            { id: 'interactions', nom: 'interactions', imageUrl: '' },
            { id: 'emotions',     nom: 'emotions',     imageUrl: '' },
          ];
        } finally {
          this.loading = false;
        }
      },
    }));
  });
</script>
