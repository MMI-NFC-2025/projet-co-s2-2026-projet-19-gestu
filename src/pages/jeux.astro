---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import arcade from '../assets/icon/arcade_jeux.svg';
---

<Layout title="Gestu — Jeux">
  <div
    class="relative flex h-screen w-full flex-col overflow-hidden"
    style="background: linear-gradient(180deg, #FFFFFF 0%, #BDE0FF 50%, #7EC8F7 100%);"
    x-data="jeuxData()"
    x-init="init()"
  >

    <PageHeader retourHref="/dashboard" retourLabel="Retour au tableau de bord" theme="light" />

    <!-- Zone centrale : borne d'arcade avec overlays -->
    <main class="relative mx-auto flex flex-1 items-center justify-center" style="width: 100vw; max-width: 36rem;">
      <div class="relative w-full">

        <!-- Image borne -->
        <img
          src={arcade.src}
          alt="Borne d'arcade"
          class="h-auto w-full object-contain"
          style="max-height: 88vh;"
        />

        <!-- Logo dans l'écran blanc (x=66-360/430, y=271-469/905) -->
        <div
          class="absolute flex items-center justify-center"
          style="top: 30%; left: 15.5%; width: 68%; height: 22%;"
        >
          <!-- Logo réduit au centre de l'écran -->
          <img
            x-show="currentGame && currentGame.logoUrl"
            :src="currentGame ? currentGame.logoUrl : ''"
            :alt="currentGame ? currentGame.nom : ''"
            class="object-contain"
            style="max-width: 60%; max-height: 70%; transition: opacity 0.3s; image-rendering: pixelated;"
          />
          <!-- Nom en fallback si pas de logo -->
          <span
            x-show="currentGame && !currentGame.logoUrl"
            x-text="currentGame ? currentGame.nom : ''"
            class="text-center text-2xl font-bold text-[#1F1F8F]"
          ></span>
        </div>

        <!-- Indicateurs de position (points) -->
        <div
          class="absolute flex items-center justify-center gap-2"
          style="top: 53%; left: 15%; width: 67%; height: 4%;"
        >
          <template x-for="(g, i) in games" :key="i">
            <div
              class="rounded-full transition-all duration-300"
              :class="i === index ? 'bg-[#1F1F8F] w-3 h-3' : 'bg-[#1F1F8F]/30 w-2 h-2'"
            ></div>
          </template>
        </div>

        <!-- Bouton rouge GAUCHE (x=84-124/430 = 19.5%-28.8%) -->
        <button
          class="absolute cursor-pointer"
          style="top: 49%; left: 12%; width: 22%; height: 14%; background: transparent;"
          @click="prev()"
          aria-label="Jeu précédent"
        ></button>

        <!-- Bouton rouge DROIT (x=299-340/430 = 69.5%-79%) -->
        <button
          class="absolute cursor-pointer"
          style="top: 49%; left: 63%; width: 22%; height: 14%; background: transparent;"
          @click="next()"
          aria-label="Jeu suivant"
        ></button>

        <!-- Bouton rouge JOUER (bas, x=163-196/430=37.9-45.6%, y=538-552/905=59.4-61%) -->
        <button
          class="absolute cursor-pointer"
          style="top: 58%; left: 36%; width: 12%; height: 6%; background: transparent;"
          @click="jouer()"
          aria-label="Jouer"
        ></button>

      </div>
    </main>

  </div>
</Layout>

<script>
  import pb from '../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('jeuxData', () => ({
      coins: 0,
      xp: 0,
      xpMax: 100,
      xpPercent: 0,
      games: [] as any[],
      index: 0,

      get currentGame() {
        return this.games[this.index] ?? null;
      },

      async init() {
        const DEV_MODE = true;
        const user = DEV_MODE ? { coins: 150, xp: 420 } : pb.authStore.model;
        this.coins = user?.coins ?? 0;
        this.xp = user?.xp ?? 0;
        this.xpPercent = Math.min(Math.round((this.xp / this.xpMax) * 100), 100);

        try {
          const records = await pb.collection('Mini_jeux').getFullList({ sort: 'ordre', requestKey: null });
          this.games = records.map((r: any) => ({
            id: r.id,
            nom: r.nom,
            type_jeux: r.type_jeux,
            logoUrl: r.logo_minijeu ? pb.files.getURL(r, r.logo_minijeu) : '',
          }));
        } catch {
          // Fallback DEV
          this.games = [
            { id: 'boss', nom: 'Boss', type_jeux: 'boss', logoUrl: '' },
            { id: 'memo', nom: 'Mémo', type_jeux: 'memo', logoUrl: '' },
            { id: 'tap', nom: 'Tap', type_jeux: 'tap', logoUrl: '' },
          ];
        }
      },

      next() {
        if (this.games.length === 0) return;
        this.index = (this.index + 1) % this.games.length;
      },

      prev() {
        if (this.games.length === 0) return;
        this.index = (this.index - 1 + this.games.length) % this.games.length;
      },

      jouer() {
        const game = this.currentGame;
        const type = game?.type_jeux ?? 'memo';
        window.location.href = `/jeux/${type}`;
      },
    }));
  });
</script>
