---
import Layout from '../layouts/Layout.astro';
import coinsIcon from '../assets/icon/coins.svg';
import retour from '../assets/icon/icone_retour_acceuil.svg';
import arcade from '../assets/icon/arcade_jeux.svg';
---

<Layout title="Gestu — Jeux">
  <div
    class="relative flex h-screen w-full flex-col overflow-hidden"
    style="background: radial-gradient(circle at 50% 50%, #4343BA 6%, #1F1F8F 29%, #0D0D3B 83%);"
    x-data="jeuxData()"
    x-init="init()"
  >

    <!-- Header -->
    <div class="flex items-center justify-between px-4 pt-4">
      <div class="flex items-center gap-2">
        <img src={coinsIcon.src} alt="Coins" class="h-9 w-9" />
        <span class="text-xl font-bold text-white" x-text="coins">—</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="h-4 w-36 overflow-hidden rounded-full bg-white/20">
          <div
            class="h-full rounded-full bg-purple-400 transition-all"
            :style="`width: ${xpPercent}%`"
          ></div>
        </div>
        <a href="/dashboard">
          <img src={retour.src} alt="Accueil" class="h-9 w-9" />
        </a>
      </div>
    </div>

    <!-- Zone centrale : borne d'arcade -->
    <div class="flex flex-1 items-center justify-center">
      <img
        src={arcade.src}
        alt="Borne d'arcade"
        class="h-auto w-[85vw] max-w-sm object-contain"
        style="max-height: 75vh;"
      />
    </div>

  </div>
</Layout>

<script>
  import pb from '../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('jeuxData', () => ({
      coins: 0,
      xp: 0,
      xpMax: 100,
      xpPercent: 0,

      async init() {
        const DEV_MODE = true;
        const user = DEV_MODE ? { coins: 150, xp: 420 } : pb.authStore.model;
        this.coins = user?.coins ?? 0;
        this.xp = user?.xp ?? 0;
        this.xpPercent = Math.min(Math.round((this.xp / this.xpMax) * 100), 100);
      }
    }));
  });
</script>
