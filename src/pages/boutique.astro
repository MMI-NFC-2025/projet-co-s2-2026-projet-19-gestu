---
import Layout from '../layouts/Layout.astro';
import BottomNav from '../components/BottomNav.astro';
import coinsIcon from '../assets/icon/coins.svg';
import retour from '../assets/icon/icone_retour_acceuil.svg';
import gestuGhost from '../assets/icon/gestu_ghost.svg';
import signes from '../assets/icon/signe_boutique.svg';
import gestuCoins from '../assets/icon/gestucoins_boutique.svg';
---

<Layout title="Gestu — Boutique">
  <div
    class="relative flex h-screen w-full flex-col overflow-hidden"
    style="background: linear-gradient(180deg, #0D0D3B 0%, #1a0a4a 100%);"
    x-data="boutiqueData()"
    x-init="init()"
  >

    <!-- Header (identique au dashboard) -->
    <div class="flex items-center justify-between px-4 pt-4">

      <!-- Coins (gauche) -->
      <div class="flex items-center gap-2">
        <img src={coinsIcon.src} alt="Coins" class="h-9 w-9" />
        <span class="text-xl font-bold text-white" x-text="coins">—</span>
      </div>

      <!-- Barre XP + icône maison → retour dashboard -->
      <div class="flex items-center gap-2">
        <div
          class="h-4 w-36 overflow-hidden rounded-full bg-white/20"
          role="progressbar"
          aria-label="Points d'expérience"
          :aria-valuenow="xp"
          :aria-valuemax="xpMax"
          aria-valuemin="0"
        >
          <div
            class="h-full rounded-full bg-purple-400 transition-all"
            :style="`width: ${xpPercent}%`"
          ></div>
        </div>
        <a href="/dashboard" aria-label="Retour au tableau de bord">
          <img src={retour.src} alt="" class="h-9 w-9" />
        </a>
      </div>
    </div>

    <!-- Boutons boutique -->
    <div class="flex flex-1 flex-col items-center justify-center gap-16">

      <!-- Gestu Ghost -->
      <a href="/boutique/ghost" class="transition-transform active:scale-95">
        <img src={gestuGhost.src} alt="Gestu Ghost" class="h-52 w-auto object-contain drop-shadow-xl" />
      </a>

      <!-- Signes -->
      <a href="/boutique/signes" class="transition-transform active:scale-95">
        <img src={signes.src} alt="Signes" class="h-52 w-auto object-contain drop-shadow-xl" />
      </a>

      <!-- Gestu Coin -->
      <a href="/boutique/coins" class="transition-transform active:scale-95">
        <img src={gestuCoins.src} alt="Gestu Coin" class="h-52 w-auto object-contain drop-shadow-xl" />
      </a>

    </div>

    <!-- Navigation bas -->
    <BottomNav active="boutique" />

  </div>
</Layout>

<script>
  import pb from '../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('boutiqueData', () => ({
      coins: 0,
      xp: 0,
      xpMax: 100,
      xpPercent: 0,

      async init() {
        const DEV_MODE = true;
        const user = DEV_MODE ? { coins: 150, xp: 420 } : pb.authStore.model;
        this.coins = user?.coins ?? 0;
        this.xp = user?.xp ?? 0;
        this.xpPercent = Math.min(Math.round((this.xp / this.xpMax) * 100), 100);
      }
    }));
  });
</script>
