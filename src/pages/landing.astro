---
const stats = [
  { value: '4–6 M', label: 'marché potentiel', detail: 'personnes concernées en France' },
  { value: '500k–1M', label: 'marché accessible', detail: 'utilisateurs mobiles potentiels' },
  { value: '700', label: 'objectif année 1', detail: 'scénario réaliste de conquête' },
];

const conceptCards = [
  {
    title: 'Signes utiles',
    text: 'Des leçons courtes pour apprendre les signes essentiels du quotidien.',
  },
  {
    title: 'Mini-jeux',
    text: 'Des modes de jeu inspirés de l’arcade pour apprendre en s’amusant.',
  },
  {
    title: 'Progression',
    text: 'XP, niveaux, récompenses et avatar motivent l’utilisateur à revenir.',
  },
];

const games = [
  {
    title: 'Memo',
    text: 'Associer les mots aux signes correspondants.',
    image: '/assets/game-over.png',
    alt: 'Écran de fin de partie GESTU',
  },
  {
    title: 'Tap',
    text: 'Cliquer sur le bon mot quand la vidéo du signe apparaît.',
    image: '/assets/quotidien.png',
    alt: 'Écran quotidien GESTU',
  },
  {
    title: 'Boss',
    text: 'Choisir le bon signe pour attaquer le boss et gagner la partie.',
    image: '/assets/boss.png',
    alt: 'Écran du jeu Boss GESTU',
  },
];

const features = [
  {
    title: 'Accueil',
    text: 'Une interface mobile simple pour accéder aux jeux et aux signes.',
    image: '/assets/phone-home.png',
    alt: 'Écran d’accueil GESTU',
  },
  {
    title: 'Boutique',
    text: 'Objets, skins et avatars à débloquer grâce aux récompenses.',
    image: '/assets/boutique.png',
    alt: 'Écran boutique GESTU',
  },
  {
    title: 'Équipe',
    text: 'Une dimension sociale pour progresser avec ses amis.',
    image: '/assets/teams.png',
    alt: 'Écran équipe GESTU',
  },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GESTU - Landing page</title>

    <style>
      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #08005f;
        color: white;
        font-family: Arial, sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      .header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(8, 0, 95, 0.95);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
      }

      .nav {
        max-width: 1180px;
        margin: 0 auto;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 0.15em;
        color: #a5f3fc;
      }

      .nav-links {
        display: flex;
        gap: 24px;
        font-size: 14px;
        font-weight: 800;
        text-transform: uppercase;
      }

      .nav-links a {
        color: rgba(255, 255, 255, 0.8);
      }

      .nav-links a:hover {
        color: #a5f3fc;
      }

      .button {
        display: inline-block;
        border-radius: 18px;
        padding: 14px 24px;
        font-weight: 900;
        text-transform: uppercase;
        font-size: 14px;
        transition: transform 0.2s ease;
      }

      .button:hover {
        transform: translateY(-3px);
      }

      .button-primary {
        background: white;
        color: #1500e8;
      }

      .button-secondary {
        border: 1px solid #f0abfc;
        background: #2110b8;
        color: white;
      }

      .section {
        max-width: 1180px;
        margin: 0 auto;
        padding: 80px 24px;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 48px;
        align-items: center;
      }

      .eyebrow {
        color: #a5f3fc;
        font-size: 13px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        margin: 0 0 24px;
      }

      h1 {
        margin: 0;
        font-size: clamp(42px, 7vw, 76px);
        line-height: 1.05;
        font-weight: 950;
      }

      h2 {
        margin: 24px 0 0;
        font-size: clamp(32px, 5vw, 52px);
        line-height: 1.1;
        font-weight: 950;
      }

      h3 {
        margin: 0;
        font-size: 26px;
        font-weight: 950;
      }

      .cyan {
        color: #a5f3fc;
      }

      .lead {
        margin-top: 28px;
        max-width: 700px;
        font-size: 22px;
        line-height: 1.6;
        color: #dbeafe;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 36px;
      }

      .panel {
        margin-top: 36px;
        max-width: 720px;
        border: 1px solid rgba(165, 243, 252, 0.4);
        background: rgba(16, 3, 110, 0.9);
        border-radius: 28px;
        padding: 24px;
        color: #dbeafe;
        font-size: 19px;
        line-height: 1.5;
      }

      .phone-frame {
        width: 100%;
        max-width: 380px;
        margin-left: auto;
        border: 1px solid rgba(165, 243, 252, 0.7);
        border-radius: 48px;
        background: rgba(0, 0, 0, 0.35);
        padding: 20px;
        box-shadow: 0 0 40px rgba(34, 211, 238, 0.25);
      }

      .phone-frame img {
        width: 100%;
        height: 620px;
        object-fit: contain;
        border-radius: 32px;
        border: 4px solid white;
        background: white;
      }

      .label {
        display: inline-block;
        background: #4e1dff;
        border: 2px solid #a5f3fc;
        border-radius: 18px;
        padding: 16px 28px;
        font-size: 14px;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 28px;
      }

      .stats-panel {
        border: 1px solid rgba(165, 243, 252, 0.35);
        background: rgba(10, 7, 86, 0.92);
        border-radius: 32px;
        padding: 32px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 36px;
      }

      .card-blue {
        border: 1px solid #67e8f9;
        background: #0a0756;
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.25);
      }

      .card-white {
        background: white;
        color: #1a1a5e;
        border: 4px solid #1500e8;
        border-radius: 28px;
        padding: 24px;
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.25);
      }

      .card-white h3 {
        color: #1500e8;
      }

      .card-text {
        margin-top: 16px;
        font-size: 18px;
        line-height: 1.55;
      }

      .image-card img,
      .feature-card img {
        display: block;
        width: 100%;
        height: 280px;
        object-fit: contain;
        border: 4px solid white;
        border-radius: 22px;
        background: white;
        margin-bottom: 20px;
      }

      .feature-card img {
        border-color: #1500e8;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 48px;
      }

      form {
        border: 1px solid #67e8f9;
        background: #0a0756;
        border-radius: 28px;
        padding: 28px;
      }

      label {
        display: block;
        font-weight: 800;
      }

      input,
      textarea {
        width: 100%;
        margin-top: 10px;
        border: 0;
        border-radius: 14px;
        padding: 14px 16px;
        font-size: 18px;
        color: black;
      }

      textarea {
        min-height: 150px;
        resize: vertical;
      }

      .footer {
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        padding: 40px 24px;
        text-align: center;
        color: #dbeafe;
      }

      @media (max-width: 900px) {
        .hero-grid,
        .contact-grid {
          grid-template-columns: 1fr;
        }

        .grid-3 {
          grid-template-columns: 1fr;
        }

        .phone-frame {
          margin: 0 auto;
        }

        .nav-links {
          display: none;
        }

        .phone-frame img {
          height: 480px;
        }
      }
    </style>
  </head>

  <body>
    <header class="header">
      <nav class="nav" aria-label="Navigation principale">
        <a href="/landing" class="logo">GESTU</a>

        <div class="nav-links">
          <a href="#concept">Concept</a>
          <a href="#jeux">Jeux</a>
          <a href="#fonctionnalites">Fonctionnalités</a>
          <a href="#contact">Contact</a>
        </div>

        <a href="#contact" class="button button-primary">Tester</a>
      </nav>
    </header>

    <main id="top">
      <section class="section">
        <div class="hero-grid">
          <div>
            <p class="eyebrow">Apprendre la LSF en jouant</p>

            <h1>
              Débloquez une nouvelle
              <span class="cyan">façon de communiquer.</span>
            </h1>

            <p class="lead">
              GESTU transforme l’apprentissage de la langue des signes française en aventure rétro-gaming :
              mini-jeux, progression, défis, récompenses et contenus à débloquer.
            </p>

            <div class="cta-row">
              <a href="#concept" class="button button-primary">Découvrir</a>
              <a href="/public-impact" class="button button-secondary">Voir l’impact</a>
            </div>

            <div class="panel">
              Pour les professionnels de santé, proches, aidants et métiers d’accueil qui veulent apprendre rapidement
              des signes utiles sans formation longue.
            </div>
          </div>

          <div class="phone-frame">
            <img src="/assets/phone-home.png" alt="Écran d’accueil de l’application GESTU" />
          </div>
        </div>
      </section>

      <section class="section">
        <div class="stats-panel">
          <p class="eyebrow">Un positionnement clair</p>

          <h2>
            Apprendre les bases utiles de la LSF grâce à une interface accessible, motivante et pensée pour le mobile.
          </h2>

          <div class="grid-3">
            {stats.map((stat) => (
              <article class="card-blue">
                <h3>{stat.value}</h3>
                <p class="card-text"><strong>{stat.label}</strong></p>
                <p class="card-text">{stat.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="concept" class="section">
        <p class="label">01 Concept</p>

        <h2>
          Une app qui remplace la leçon classique
          <span class="cyan">par une aventure arcade.</span>
        </h2>

        <p class="lead">
          GESTU ne promet pas de former des experts. L’objectif est de découvrir les bases, progresser petit à petit
          et ressentir une satisfaction rapide.
        </p>

        <div class="grid-3">
          {conceptCards.map((card) => (
            <article class="card-white">
              <h3>{card.title}</h3>
              <p class="card-text">{card.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="jeux" class="section">
        <p class="label">02 Mini-jeux</p>

        <h2>
          Un univers rétro qui donne
          <span class="cyan">envie de rejouer.</span>
        </h2>

        <p class="lead">
          Les jeux utilisent les mots, signes et vidéos de l’application pour créer une expérience d’apprentissage rapide,
          visuelle et motivante.
        </p>

        <div class="grid-3">
          {games.map((game) => (
            <article class="card-blue image-card">
              <img src={game.image} alt={game.alt} />
              <h3>{game.title}</h3>
              <p class="card-text">{game.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="fonctionnalites" class="section">
        <p class="label">03 Fonctionnalités</p>

        <h2>
          Tout ce qu’il faut pour progresser
          <span class="cyan">à son rythme.</span>
        </h2>

        <div class="grid-3">
          {features.map((feature) => (
            <article class="card-white feature-card">
              <img src={feature.image} alt={feature.alt} />
              <h3>{feature.title}</h3>
              <p class="card-text">{feature.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" class="section">
        <div class="contact-grid">
          <div>
            <p class="label">Contact</p>

            <h2>Une question, un test ou un partenariat ?</h2>

            <p class="lead">
              Cette section permet aux utilisateurs, associations, écoles de santé ou structures d’accueil
              de prendre contact avec l’équipe GESTU.
            </p>
          </div>

          <form action="mailto:contact@gestu.fr" method="post" enctype="text/plain">
            <label>
              Email
              <input type="email" name="email" placeholder="nom@email.fr" required />
            </label>

            <label style="margin-top: 20px;">
              Message
              <textarea name="message" placeholder="Votre message..." required></textarea>
            </label>

            <button class="button button-primary" style="margin-top: 24px;" type="submit">
              Envoyer
            </button>
          </form>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>© 2026 GESTU — Apprendre la langue des signes en jouant.</p>
      <p>
        <a href="/public-impact" style="color:#a5f3fc;">Voir la page Publics & Impact</a>
      </p>
    </footer>
  </body>
</html>