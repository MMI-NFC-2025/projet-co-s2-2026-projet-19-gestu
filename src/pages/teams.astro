---
import Layout from '../layouts/Layout.astro';
import retour from '../assets/icon/fleche_retour.svg';
import iconeteam from '../assets/img/iconeteam.avif';
import ellipseteam from '../assets/img/ellipseteam.avif';
import boutonCreerTeam from '../assets/icon/boutoncréetateam.svg';
---

<Layout title="Gestu — Teams">
  <div
    class="relative h-screen w-full overflow-hidden select-none"
    style="background: linear-gradient(to bottom, #202094 0%, #0A0A2E 100%);"
    x-data="teamsPage()"
    x-init="init()"
  >

    <!-- ══ ELLIPSE fond ══ -->
    <img
      src={ellipseteam.src}
      alt=""
      class="absolute left-1/2 -translate-x-1/2 pointer-events-none"
      style="top: -8%; width: 105%; max-width: 480px; opacity: 0.95;"
      aria-hidden="true"
    />

    <!-- ══ CONTENU PRINCIPAL ══ -->
    <div class="relative z-10 flex h-full flex-col">

      <!-- Zone haute : icône team -->
      <div class="flex flex-1 items-center justify-center">
        <img
          src={iconeteam.src}
          alt="Équipe"
          style="width: 70%; max-width: 300px; object-fit: contain;"
        />
      </div>

      <!-- Zone basse : barre de recherche + bouton -->
      <div class="shrink-0 flex flex-col items-center gap-5 px-8 pb-28">

        <!-- Barre de recherche -->
        <div class="relative w-full">
          <input
            type="text"
            placeholder="Rechercher une team..."
            x-model="recherche"
            @keydown.enter="rechercherTeam()"
            class="w-full rounded-full py-3 pl-5 pr-14 outline-none"
            style="
              background: rgba(255,255,255,0.95);
              font-family: 'Josefin Sans', sans-serif;
              font-size: 14px;
              color: #1a1a4e;
            "
          />
          <button
            @click="rechercherTeam()"
            class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center rounded-full transition-opacity active:opacity-60"
            style="width: 34px; height: 34px; background: #3208D2;"
            aria-label="Rechercher"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"/>
              <line x1="16.5" y1="16.5" x2="22" y2="22"/>
            </svg>
          </button>
        </div>

        <!-- Bouton Crée ta team -->
        <a href="/teams/creer" class="active:opacity-70 transition-opacity">
          <img src={boutonCreerTeam.src} alt="Crée ta team" style="width: 157px; height: 59px; object-fit: contain;" />
        </a>

      </div>
    </div>

    <!-- ══ OVERLAY fermeture ══ -->
    <div
      x-show="resultats.length > 0"
      class="absolute inset-0 z-20"
      @click="resultats = []"
    ></div>

    <!-- ══ RÉSULTATS RECHERCHE ══ -->
    <div
      x-show="resultats.length > 0"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      class="absolute z-30 left-8 right-8 rounded-2xl overflow-y-auto"
      style="bottom: 120px; max-height: 55vh; background: rgba(20,10,60,0.97); border: 1px solid rgba(100,80,255,0.4);"
    >
      <template x-for="team in resultats" :key="team.id">
        <div
          class="flex items-center gap-3 px-4 py-3"
          style="border-bottom: 1px solid rgba(255,255,255,0.06);"
        >
          <!-- Initiale -->
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-white font-bold text-sm"
            style="background: #3208D2;"
            x-text="(team.nom || '?')[0].toUpperCase()"
          ></span>

          <!-- Nom + membres -->
          <div class="flex-1 min-w-0">
            <p class="text-white text-sm font-bold truncate" x-text="team.nom" style="font-family:'Josefin Sans',sans-serif;"></p>
            <p class="text-white/50 text-xs" x-text="team.membres + ' membre' + (team.membres > 1 ? 's' : '')" style="font-family:'Josefin Sans',sans-serif;"></p>
          </div>

          <!-- Badge "Votre team" -->
          <template x-if="team.id === userTeamId">
            <a
              :href="`/teams/${team.id}`"
              class="shrink-0 flex items-center justify-center rounded-full px-3 py-1 active:opacity-70"
              style="background:#3208D2;border:1px solid rgba(255,255,255,0.4);"
            >
              <span style="font-family:'Josefin Sans',sans-serif;font-size:11px;color:white;white-space:nowrap;">Votre team</span>
            </a>
          </template>

          <!-- Bouton Rejoindre (pas de team) -->
          <template x-if="team.id !== userTeamId && userTeamId === ''">
            <button
              type="button"
              @click="rejoindre(team.id)"
              :disabled="enCours"
              class="shrink-0 flex items-center justify-center rounded-full px-3 py-1 active:opacity-70 disabled:opacity-40"
              style="background:#0050FF;border:1px solid rgba(255,255,255,0.4);"
            >
              <span style="font-family:'Josefin Sans',sans-serif;font-size:11px;color:white;white-space:nowrap;">Rejoindre</span>
            </button>
          </template>

          <!-- Bouton désactivé (déjà dans une autre team) -->
          <template x-if="team.id !== userTeamId && userTeamId !== ''">
            <button
              type="button"
              disabled
              class="shrink-0 flex items-center justify-center rounded-full px-3 py-1 opacity-30 cursor-not-allowed"
              style="background:#555;border:1px solid rgba(255,255,255,0.2);"
              title="Quittez votre team actuelle avant d'en rejoindre une autre"
            >
              <span style="font-family:'Josefin Sans',sans-serif;font-size:11px;color:white;white-space:nowrap;">Rejoindre</span>
            </button>
          </template>
        </div>
      </template>

      <!-- Message quitter team -->
      <div
        x-show="userTeamId !== '' && resultats.some(t => t.id !== userTeamId)"
        class="px-4 py-2"
        style="background:rgba(255,200,0,0.08);border-top:1px solid rgba(255,200,0,0.15);"
      >
        <p style="font-family:'Josefin Sans',sans-serif;font-size:11px;color:rgba(255,220,80,0.85);text-align:center;">
          Vous devez quitter votre team actuelle avant d'en rejoindre une autre.
        </p>
      </div>
    </div>

    <!-- ══ FLÈCHE RETOUR ══ -->
    <a
      href="/dashboard"
      class="absolute z-20 flex items-center justify-center transition-opacity active:opacity-60"
      style="bottom: 32px; left: 28px; width: 44px; height: 44px;"
      aria-label="Retour"
    >
      <img src={retour.src} alt="" class="h-7 w-7 object-contain" />
    </a>

  </div>
</Layout>

<script>
  import pb from '../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('teamsPage', () => ({
      recherche: '',
      resultats: [] as { id: string; nom: string; membres: number }[],
      userTeamId: '',
      userId: '',
      enCours: false,

      async init() {
        const user = pb.authStore.model;
        if (user) {
          this.userId = user.id;
          this.userTeamId = (user as any).team ?? '';
          console.log('Team du joueur connecté:', this.userTeamId);
        }
      },

      async rechercherTeam() {
        const q = this.recherche.trim();
        if (!q) { this.resultats = []; return; }
        try {
          const filter = `nom_team ~ "${q}" && visibilite = "publique"`;

          const records = await pb.collection('Teams').getFullList({
            filter,
            requestKey: null,
          });

          console.log('Résultats de recherche:', records);

          const teamsWithCounts = await Promise.all(
            records.map(async (r: any) => {
              try {
                const res = await pb.collection('Utilisateurs').getList(1, 1, {
                  filter: `team = "${r.id}"`,
                  requestKey: null,
                });
                return { id: r.id, nom: r.nom_team ?? '', membres: res.totalItems };
              } catch {
                return { id: r.id, nom: r.nom_team ?? '', membres: 0 };
              }
            })
          );

          this.resultats = teamsWithCounts;
        } catch (e: any) {
          console.error('Erreur recherche teams:', e);
          this.resultats = [];
        }
      },

      async rejoindre(teamId: string) {
        console.log("Id de la team sélectionnée pour rejoindre:", teamId);
        if (!this.userId) return;
        this.enCours = true;
        try {
          await pb.collection('Utilisateurs').update(this.userId, { team: teamId });
          window.location.href = `/teams/${teamId}`;
        } catch (e: any) {
          console.error('Erreur rejoindre:', e);
          this.enCours = false;
        }
      },
    }));
  });
</script>
