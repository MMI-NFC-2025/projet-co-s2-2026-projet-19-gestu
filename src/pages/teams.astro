---
import Layout from '../layouts/Layout.astro';
import retour from '../assets/icon/fleche_retour.svg';
import iconeteam from '../assets/img/iconeteam.avif';
import ellipseteam from '../assets/img/ellipseteam.avif';
import boutonCreerTeam from '../assets/icon/boutoncréetateam.svg';
---

<Layout title="Gestu — Teams">
  <div
    class="relative h-screen w-full overflow-hidden select-none"
    style="background: linear-gradient(to bottom, #202094 0%, #0A0A2E 100%);"
    x-data="teamsPage()"
    x-init="init()"
  >

    <!-- ══ ELLIPSE fond ══ -->
    <img
      src={ellipseteam.src}
      alt=""
      class="absolute left-1/2 -translate-x-1/2 pointer-events-none"
      style="top: -8%; width: 105%; max-width: 480px; opacity: 0.95;"
      aria-hidden="true"
    />

    <!-- ══ CONTENU PRINCIPAL ══ -->
    <div class="relative z-10 flex h-full flex-col">

      <!-- Zone haute : icône team -->
      <div class="flex flex-1 items-center justify-center">
        <img
          src={iconeteam.src}
          alt="Équipe"
          style="width: 70%; max-width: 300px; object-fit: contain;"
        />
      </div>

      <!-- Zone basse : barre de recherche + bouton -->
      <div class="shrink-0 flex flex-col items-center gap-5 px-8 pb-28">

        <!-- Barre de recherche -->
        <div class="relative w-full">
          <input
            type="text"
            placeholder="Rechercher une team..."
            x-model="recherche"
            @keydown.enter="rechercherTeam()"
            class="w-full rounded-full py-3 pl-5 pr-14 outline-none"
            style="
              background: rgba(255,255,255,0.95);
              font-family: 'Josefin Sans', sans-serif;
              font-size: 14px;
              color: #1a1a4e;
            "
          />
          <button
            @click="rechercherTeam()"
            class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center rounded-full transition-opacity active:opacity-60"
            style="width: 34px; height: 34px; background: #3208D2;"
            aria-label="Rechercher"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"/>
              <line x1="16.5" y1="16.5" x2="22" y2="22"/>
            </svg>
          </button>
        </div>

        <!-- Bouton Crée ta team -->
        <a href="/teams/creer" class="active:opacity-70 transition-opacity">
          <img src={boutonCreerTeam.src} alt="Crée ta team" style="width: 157px; height: 59px; object-fit: contain;" />
        </a>

      </div>
    </div>

    <!-- ══ RÉSULTATS RECHERCHE ══ -->
    <div
      x-show="resultats.length > 0"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      class="absolute z-30 left-8 right-8 rounded-2xl overflow-hidden"
      style="bottom: 220px; background: rgba(20,10,60,0.97); border: 1px solid rgba(100,80,255,0.4);"
    >
      <template x-for="team in resultats" :key="team.id">
        <a
          :href="`/teams/${team.id}`"
          class="flex items-center gap-3 px-4 py-3 transition-colors active:bg-white/10"
          style="border-bottom: 1px solid rgba(255,255,255,0.06);"
        >
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-white font-bold text-sm"
            style="background: #3208D2;"
            x-text="(team.nom || '?')[0].toUpperCase()"
          ></span>
          <div>
            <p class="text-white text-sm font-bold" x-text="team.nom" style="font-family:'Josefin Sans',sans-serif;"></p>
            <p class="text-white/50 text-xs" x-text="team.membres + ' membres'" style="font-family:'Josefin Sans',sans-serif;"></p>
          </div>
        </a>
      </template>
    </div>

    <!-- ══ FLÈCHE RETOUR ══ -->
    <a
      href="/dashboard"
      class="absolute z-20 flex items-center justify-center transition-opacity active:opacity-60"
      style="bottom: 32px; left: 28px; width: 44px; height: 44px;"
      aria-label="Retour"
    >
      <img src={retour.src} alt="" class="h-7 w-7 object-contain" />
    </a>

  </div>
</Layout>

<script>
  import pb from '../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('teamsPage', () => ({
      recherche: '',
      resultats: [] as { id: string; nom: string; membres: number }[],

      async init() {
        // TODO: charger les teams suggérées depuis PocketBase (collection Teams)
      },

      async rechercherTeam() {
        const q = this.recherche.trim();
        if (!q) { this.resultats = []; return; }
        try {
          // TODO: remplacer par vraie requête PocketBase
          // const records = await pb.collection('Teams').getList(1, 5, {
          //   filter: `nom ~ "${q}"`,
          //   requestKey: null,
          // });
          // this.resultats = records.items.map(r => ({ id: r.id, nom: r.nom, membres: r.membres ?? 0 }));
          this.resultats = [];
        } catch {
          this.resultats = [];
        }
      },
    }));
  });
</script>
