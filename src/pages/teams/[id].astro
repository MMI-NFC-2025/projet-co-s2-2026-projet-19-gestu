---
import Layout from '../../layouts/Layout.astro';
import ghostPlaceholder from '../../assets/icon/gestu_ghost.svg';

const { id } = Astro.params;
---

<Layout title="Gestu — Team">
  <div
    class="relative h-screen w-full overflow-hidden select-none"
    style="background: linear-gradient(180deg, #0A0A2E 0%, #202094 100%);"
    data-team-id={id}
    data-ghost={ghostPlaceholder.src}
    x-data="teamPage()"
    x-init="init()"
  >

    <!-- ══ CHARGEMENT ══ -->
    <div x-show="loading" class="flex h-full items-center justify-center">
      <div class="h-10 w-10 animate-spin rounded-full border-4 border-purple-300 border-t-transparent"></div>
    </div>

    <!-- ══ ERREUR ══ -->
    <div x-show="erreur !== ''" class="flex h-full flex-col items-center justify-center px-8 text-center gap-4">
      <p x-text="erreur" style="font-family:'Josefin Sans',sans-serif;color:#fca5a5;font-size:14px;"></p>
      <a href="/teams" style="font-family:'Josefin Sans',sans-serif;color:rgba(255,255,255,0.6);font-size:13px;text-decoration:underline;">Retour aux teams</a>
    </div>

    <!-- ══ CONTENU ══ -->
    <div x-show="!loading && erreur === ''" class="flex h-full flex-col px-5 pt-10 pb-6 gap-5">

      <!-- Titre team -->
      <h1
        x-text="team.nom"
        style="font-family:'Josefin Sans',sans-serif;font-weight:700;font-size:52px;color:white;line-height:1;"
      ></h1>

      <!-- Bannière team (blazon + déco) -->
      <div
        class="relative flex items-center overflow-hidden rounded-xl"
        style="height:53px;background:linear-gradient(135deg,#3208D2 0%,#1C0086 60%,#4B1EF5 100%);border:2px solid #0000FE;"
      >
        <!-- Blazon -->
        <div class="flex items-center justify-center shrink-0 ml-3" style="width:38px;height:38px;background:rgba(0,0,0,0.3);border-radius:6px;border:1px solid rgba(255,255,255,0.25);">
          <img :src="team.blazonUrl || ghostSrc" class="w-full h-full object-contain p-1" alt="Blazon" />
        </div>
        <!-- Cercle déco centre -->
        <div class="flex-1 flex justify-center">
          <div style="width:32px;height:32px;background:rgba(100,50,200,0.5);border-radius:50%;border:2px solid rgba(255,255,255,0.2);"></div>
        </div>
        <!-- Badge droite -->
        <div class="flex items-center justify-center mr-3 shrink-0" style="width:32px;height:32px;background:#0050FF;border-radius:6px;border:2px solid rgba(255,255,255,0.5);transform:rotate(45deg);">
          <span style="transform:rotate(-45deg);font-family:'Press Start 2P',monospace;font-size:7px;color:white;" x-text="membres.length"></span>
        </div>
      </div>

      <!-- Liste membres (joueurteamgroupe) -->
      <div class="flex flex-col gap-2 flex-1 overflow-y-auto">
        <template x-for="(membre, index) in membres" :key="membre.id">
          <div
            class="relative overflow-hidden rounded-xl"
            style="height:53px;flex-shrink:0;border:2px solid #0000FE;"
          >
            <!-- Fond blanc gauche + violet droit (diagonal) -->
            <div class="absolute inset-0" style="background:white;"></div>
            <div class="absolute inset-0" style="background:linear-gradient(135deg,#3208D2 0%,#1C0086 100%);clip-path:polygon(55% 0%, 100% 0%, 100% 100%, 35% 100%);"></div>

            <!-- Contenu -->
            <div class="relative flex items-center h-full px-2 gap-2">
              <!-- Rang -->
              <div
                class="flex items-center justify-center shrink-0"
                style="width:30px;height:30px;background:#0000FE;border-radius:4px;"
              >
                <span x-text="index + 1" style="font-family:'Press Start 2P',monospace;font-size:9px;color:white;"></span>
              </div>

              <!-- Pseudo + rôle -->
              <div class="flex flex-col min-w-0" style="width:80px;">
                <span x-text="membre.pseudo" style="font-family:'Josefin Sans',sans-serif;font-weight:700;font-size:14px;color:#0D0D3B;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span>
                <span x-text="membre.isChef ? 'Chef' : 'Membre'" style="font-family:'Josefin Sans',sans-serif;font-size:10px;color:#3208D2;"></span>
              </div>

              <!-- Avatar -->
              <div class="shrink-0 overflow-hidden" style="width:30px;height:30px;border-radius:50%;border:2px solid white;">
                <img :src="membre.avatarUrl || ghostSrc" class="w-full h-full object-contain" alt="" />
              </div>

              <!-- Spacer -->
              <div class="flex-1"></div>

              <!-- Niveau -->
              <div
                class="flex items-center justify-center shrink-0 mr-1"
                style="width:34px;height:34px;background:#0050FF;border-radius:50%;border:2px solid white;"
              >
                <span x-text="membre.niveaux" style="font-family:'Press Start 2P',monospace;font-size:8px;color:white;"></span>
              </div>
            </div>
          </div>
        </template>

        <!-- Aucun membre -->
        <p
          x-show="membres.length === 0"
          class="text-center py-4"
          style="font-family:'Josefin Sans',sans-serif;color:rgba(255,255,255,0.4);font-size:13px;"
        >
          Aucun membre
        </p>
      </div>

    </div>

    <!-- ══ 3 ICÔNES BAS ══ -->
    <div
      x-show="!loading"
      class="absolute bottom-6 left-0 right-0 flex justify-center gap-4"
    >
      <!-- Retour teams -->
      <a
        href="/teams"
        class="flex items-center justify-center rounded-xl transition-opacity active:opacity-60"
        style="width:62px;height:62px;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.3);"
        aria-label="Retour aux teams"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 14L4 9l5-5"/>
          <path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
        </svg>
      </a>

      <!-- Guerres (trophy) -->
      <button
        type="button"
        class="flex items-center justify-center rounded-xl transition-opacity active:opacity-60"
        style="width:62px;height:62px;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.3);"
        aria-label="Guerres"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
          <path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
          <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
          <path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/>
        </svg>
      </button>

      <!-- Chat -->
      <button
        type="button"
        class="flex items-center justify-center rounded-xl transition-opacity active:opacity-60"
        style="width:62px;height:62px;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.3);"
        aria-label="Chat"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          <circle cx="9" cy="10" r="1" fill="white"/><circle cx="12" cy="10" r="1" fill="white"/><circle cx="15" cy="10" r="1" fill="white"/>
        </svg>
      </button>
    </div>

  </div>
</Layout>

<script>
  import pb from '../../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('teamPage', () => ({
      loading: true,
      erreur: '',
      team: { nom: '', blazonUrl: '', createur: '' },
      membres: [] as any[],
      ghostSrc: '',

      async init() {
        const el = document.querySelector('[data-team-id]') as HTMLElement;
        const teamId = el?.dataset.teamId ?? '';
        this.ghostSrc = el?.dataset.ghost ?? '';

        if (!teamId) { this.erreur = 'Team introuvable.'; this.loading = false; return; }

        try {
          // Charger la team
          const team = await pb.collection('Teams').getOne(teamId, {
            expand: 'blason',
            requestKey: null,
          });

          const blazonRecord = (team as any).expand?.blason;
          const blazonUrl = blazonRecord?.image_avatar
            ? pb.files.getURL(blazonRecord, blazonRecord.image_avatar)
            : '';

          this.team = { nom: (team as any).nom_team ?? '', blazonUrl, createur: (team as any).createur ?? '' };

          // Charger les membres (tri par niveau décroissant)
          const membres = await pb.collection('Utilisateurs').getFullList({
            filter: `team = "${teamId}"`,
            expand: 'avatar',
            sort: '-niveaux,-xp',
            requestKey: null,
          });

          this.membres = membres.map((m: any) => {
            const avatarRecord = m.expand?.avatar;
            return {
              id: m.id,
              pseudo: m.pseudo ?? m.id,
              niveaux: m.niveaux || 1,
              xp: m.xp || 0,
              isChef: m.id === this.team.createur,
              avatarUrl: avatarRecord?.image_avatar
                ? pb.files.getURL(avatarRecord, avatarRecord.image_avatar)
                : '',
            };
          });
        } catch (e: any) {
          this.erreur = e?.message ?? 'Erreur de chargement.';
        } finally {
          this.loading = false;
        }
      },
    }));
  });
</script>
