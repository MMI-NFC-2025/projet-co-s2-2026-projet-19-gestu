---
import Layout from '../../layouts/Layout.astro';
import retour from '../../assets/icon/fleche_retour.svg';
---

<Layout title="Gestu — Apprendre">
  <div
    class="relative flex h-screen w-full flex-col overflow-hidden"
    style="background: radial-gradient(circle at 50% 50%, #4343BA 6%, #1F1F8F 29%, #0D0D3B 83%);"
    x-data="categorieData()"
    x-init="init()"
  >

    <!-- Liste des mots scrollable -->
    <main class="flex-1 overflow-y-auto px-8 py-8 pb-28">

      <!-- Chargement -->
      <div x-show="loading" class="flex h-40 items-center justify-center">
        <div class="h-10 w-10 animate-spin rounded-full border-4 border-purple-400 border-t-transparent"></div>
      </div>

      <!-- Erreur -->
      <div
        x-show="!loading && erreur"
        x-text="erreur"
        role="alert"
        class="py-10 text-center text-red-300"
        style="font-family: 'Press Start 2P', monospace; font-size: 11px; line-height: 1.8;"
      ></div>

      <!-- Boutons mots -->
      <div x-show="!loading && !erreur" class="flex flex-col gap-4">
        <template x-for="signe in signes" :key="signe.id">
          <button
            @click="ouvrirVideo(signe)"
            :aria-label="`Voir la vidéo du signe : ${signe.mot}`"
            class="w-full cursor-pointer transition-transform active:scale-95"
          >
            <img
              x-show="signe.imageUrl"
              :src="signe.imageUrl"
              :alt="signe.mot"
              class="w-full object-contain"
              style="max-height: 120px;"
              @error="signe.imageUrl = ''"
            />
          </button>
        </template>

        <!-- Aucun signe -->
        <p
          x-show="!loading && !erreur && signes.length === 0"
          class="py-10 text-center text-white/40"
          style="font-family: 'Press Start 2P', monospace; font-size: 12px;"
        >
          Aucun signe disponible
        </p>
      </div>
    </main>

    <!-- Bouton retour fixé en bas à gauche -->
    <div class="fixed bottom-6 left-6 z-20">
      <a href="/apprendre" aria-label="Retour aux catégories">
        <img src={retour.src} alt="" class="h-10 w-10 opacity-80 transition-opacity hover:opacity-100" />
      </a>
    </div>

    <!-- Modal vidéo -->
    <div
      x-show="modal.open"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 z-50 flex items-center justify-center px-6"
      style="background: rgba(0,0,0,0.88);"
      @click.self="fermerVideo()"
      role="dialog"
      :aria-label="modal.mot ? `Vidéo du signe : ${modal.mot}` : 'Vidéo'"
      aria-modal="true"
    >
      <div class="w-full max-w-sm">
        <!-- Titre du signe -->
        <p
          x-text="modal.mot"
          class="mb-4 text-center text-white capitalize"
          style="font-family: 'Press Start 2P', monospace; font-size: 16px;"
        ></p>

        <!-- Vidéo -->
        <video
          x-ref="videoEl"
          :src="modal.videoUrl"
          class="w-full rounded-2xl bg-black"
          controls
          playsinline
          preload="metadata"
          style="max-height: 58vh;"
        ></video>

        <!-- Bouton fermer -->
        <button
          @click="fermerVideo()"
          class="mt-5 w-full rounded-2xl py-4 text-center text-white transition-opacity active:opacity-70"
          style="
            background: linear-gradient(160deg, #9B5EFF 0%, #6B28D4 100%);
            border: 2.5px solid rgba(255,255,255,0.75);
            box-shadow: 0 5px 0 #2D0E6E;
            font-family: 'Press Start 2P', monospace;
            font-size: 13px;
          "
          aria-label="Fermer la vidéo"
        >
          Fermer
        </button>
      </div>
    </div>

  </div>
</Layout>

<script>
  import pb from '../../lib/pocketbase.js';

  document.addEventListener('alpine:init', () => {
    (window as any).Alpine.data('categorieData', () => ({
      signes: [] as any[],
      loading: true,
      erreur: '',
      modal: { open: false, mot: '', videoUrl: '' },

      async init() {
        // Lire l'id de la catégorie depuis le query string (?id=xxx)
        const params = new URLSearchParams(window.location.search);
        const categorieId = params.get('id') ?? '';

        if (!categorieId) {
          this.erreur = 'Paramètre id manquant dans l\'URL.';
          this.loading = false;
          return;
        }

        try {
          // Test de connexion PocketBase
          const records = await pb.collection('Signes').getFullList({
            filter: `categorie = "${categorieId}"`,
            sort: 'mot',
            requestKey: null,
          });

          this.signes = records.map((s: any) => ({
            id: s.id,
            mot: s.mot ?? '',
            imageUrl: s.image ? pb.files.getURL(s, s.image) + `?t=${s.updated}` : '',
            videoUrl: s.video ? pb.files.getURL(s, s.video) + `?t=${s.updated}` : '',
          }));

          if (this.signes.length === 0) {
            console.warn('Aucun signe trouvé pour categorieId:', categorieId);
          }
        } catch (e: any) {
          console.error('Erreur PocketBase complète:', e);
          const msg = e?.response?.message || e?.message || JSON.stringify(e);
          this.erreur = `Erreur: ${msg}\n\nID catégorie: ${categorieId}\nURL PocketBase: http://127.0.0.1:8090`;
        } finally {
          this.loading = false;
        }
      },

      ouvrirVideo(signe: any) {
        if (!signe.videoUrl) return;
        this.modal = { open: true, mot: signe.mot, videoUrl: signe.videoUrl };
        this.$nextTick(() => {
          const v = this.$refs.videoEl as HTMLVideoElement;
          v?.load();
          v?.play().catch(() => {});
        });
      },

      fermerVideo() {
        (this.$refs.videoEl as HTMLVideoElement)?.pause();
        this.modal = { open: false, mot: '', videoUrl: '' };
      },
    }));
  });
</script>
